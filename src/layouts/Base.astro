---
import '@fontsource-variable/sora';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource/dm-mono/300.css';
import '@fontsource/dm-mono/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Pages without the dot canvas get a static dot floor instead. */
  floor?: boolean;
}

const { title, description, floor = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // The home page always opens at the top: a shared link must land on the hero.
      // Runs before the page is laid out, so there is no jump.
      (() => {
        if (location.pathname !== '/') return;
        const entry = performance.getEntriesByType('navigation')[0];
        const type = entry ? entry.type : 'navigate';
        // Coming back with the Back button is the one case where the visitor keeps their place.
        if (type === 'back_forward') return;

        let fromThisSite = false;
        try {
          fromThisSite = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
        } catch {}

        // "All work" on a case study is the only way to open at a section, and even then
        // the #section is taken off the address so it cannot be copied into a shared link.
        if (location.hash && fromThisSite && type === 'navigate') window.__openAt = location.hash;
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);

        history.scrollRestoration = 'manual';
        const top = () => {
          if (!window.__openAt) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        };
        top();
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) top();
        });
        // Once open, hand scroll memory back to the browser so Back from a case study works.
        window.addEventListener('load', () => setTimeout(() => (history.scrollRestoration = 'auto'), 0));
      })();
    </script>
  </head>
  <body class:list={{ 'has-floor': floor }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Rourke Paslovsky</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
