---
import type { Passage } from '../lib/work';

interface Props {
  passages: Passage[];
  sourceCount: number;
}

const { passages, sourceCount } = Astro.props;

const suggestions = [
  'How do you stop a model making things up?',
  'What have you shipped on WhatsApp?',
  'How fast can you deliver?',
  'Which languages do your systems speak?',
];

// Escape "<" so passage text can never close the script element.
const corpus = JSON.stringify(passages).replace(/</g, '\\u003c');
---

<div class="ask" data-ask data-source-count={sourceCount}>
  <form class="ask-form" data-ask-form>
    <label class="ask-label" for="ask-input">Ask my work a question</label>
    <div class="ask-field">
      <input
        id="ask-input"
        name="q"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Type a question"
        data-ask-input
      />
      <button type="submit">Ask</button>
    </div>
  </form>

  <ul class="ask-suggestions" aria-label="Suggested questions">
    {
      suggestions.map((q) => (
        <li>
          <button type="button" data-ask-suggestion>
            {q}
          </button>
        </li>
      ))
    }
  </ul>

  <div class="ask-result" data-ask-result aria-live="polite"></div>

  <p class="ask-note">
    Runs in your browser with no model behind it, so it can only quote what is written on this
    site. When the site doesn't cover something, it says so.
  </p>

  <script type="application/json" data-ask-corpus set:html={corpus} />
</div>

<script>
  import { createIndex, excerpt, highlight } from '../lib/retrieve.js';

  const root = document.querySelector<HTMLElement>('[data-ask]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-ask-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-ask-input]')!;
    const result = root.querySelector<HTMLElement>('[data-ask-result]')!;
    const passages = JSON.parse(root.querySelector('[data-ask-corpus]')!.textContent || '[]');
    const index = createIndex(passages);
    const sourceCount = root.dataset.sourceCount ?? 'the';

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    const answer = (query: string) => {
      const { hits, matched } = index.search(query);
      result.replaceChildren();

      if (!hits.length) {
        const none = el('div', 'ask-none');
        none.append(el('p', 'ask-none-title', 'No source for that.'));
        const body = el(
          'p',
          undefined,
          `This box only quotes this site: my ${sourceCount} case studies and the About section. None of it covers that. `
        );
        const mail = el('a', undefined, 'Ask me directly by email');
        mail.href = 'mailto:rourke.paslovsky3@gmail.com';
        body.append(mail, '.');
        none.append(body);
        result.append(none);
        return;
      }

      const list = el('ol', 'ask-hits');
      for (const { passage } of hits) {
        const item = el('li');
        const quote = el('blockquote');
        for (const part of highlight(excerpt(passage.text, matched), matched)) {
          quote.append(part.hit ? el('mark', undefined, part.text) : part.text);
        }
        const source = el('a', 'ask-source');
        source.href = passage.href;
        source.append(el('span', 'cite', String(passage.n)), `${passage.title}, ${passage.section}`);
        item.append(quote, source);
        list.append(item);
      }
      result.append(list);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      if (query) answer(query);
      else input.focus();
    });

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-ask-suggestion]')) {
      button.addEventListener('click', () => {
        input.value = button.textContent?.trim() ?? '';
        answer(input.value);
      });
    }
  }
</script>
